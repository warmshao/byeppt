{
  "name": "@byeppt/shell",
  "productName": "ByePPT",
  "version": "0.1.6",
  "license": "AGPL-3.0-only",
  "private": true,
  "description": "byeppt desktop shell: home/launcher window + tab strip hosting the slides editor as WebContentsView tabs",
  "main": "out/main/index.js",
  "desktopName": "byeppt.desktop",
  "scripts": {
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "start": "electron-vite build && electron .",
    "dist:mac": "npm run clean:release && npm run build:mac:all",
    "dist:mac:arm64": "npm run clean:release && npm run build:mac:arm64",
    "dist:mac:x64": "npm run clean:release && npm run build:mac:x64",
    "dist:win": "npm run clean:release && npm run build:win",
    "dist:linux": "npm run clean:release && npm run build:linux",
    "clean:release": "node ../../tools/clean-release.mjs",
    "build:mac:arm64": "electron-vite build && electron-builder --mac --arm64 --publish never",
    "build:mac:x64": "electron-vite build && electron-builder --mac --x64 --publish never",
    "build:win": "electron-vite build && electron-builder --win --publish never",
    "build:linux": "electron-vite build && electron-builder --linux --publish never",
    "build:mac:all": "electron-vite build && electron-builder --mac --arm64 --x64 --publish never"
  },
  "devDependencies": {
    "@byeppt/app": "*",
    "@byeppt/electron-utils": "*",
    "@byeppt/i18n": "*",
    "@byeppt/pptx-engine": "*",
    "@byeppt/pptx-render": "*",
    "@byeppt/project-store": "*",
    "@byeppt/ui": "*",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "^43.3.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.1.10"
  },
  "author": "byeppt",
  "dependencies": {
    "@warmshao/vsurf": "^0.7.6",
    "electron-updater": "^6.8.9",
    "vsurf-ai": "^0.7.6"
  }
}
